# Puerto e interfaz de escucha (0.0.0.0 para que el teléfono/emulador lo alcance por la LAN)
PORT=4000
HOST=0.0.0.0

# URL pública con la que el teléfono ve este backend (se usa en el QR de enrolamiento)
PUBLIC_BASE_URL=http://192.168.1.10:4000

# Secreto HMAC para firmar los JWT. Genera uno propio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres

# Cliente OAuth público (sin client_secret)
OAUTH_CLIENT_ID=unisabana-mobile
# Redirect URIs permitidos, separados por coma (comparación exacta)
ALLOWED_REDIRECT_URIS=unisabana-auth://callback
# Permite redirect URIs de Expo Go (exp://...) SOLO en desarrollo
ALLOW_EXPO_DEV_REDIRECTS=true

# Vida útil de los tokens (segundos)
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=2592000
ELEVATED_TOKEN_TTL_SECONDS=600
STEP_UP_TOKEN_TTL_SECONDS=300
AUTH_CODE_TTL_SECONDS=60

# Usuario de demostración
DEMO_USER_EMAIL=estudiante@unisabana.edu.co
DEMO_USER_PASSWORD=Sabana2026*
DEMO_USER_NAME=Estudiante UniSabana
# Semilla TOTP Base32 del usuario demo
DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
TOTP_ISSUER=UniSabana

# Habilita la página /enroll con el QR (solo laboratorio)
ENABLE_ENROLL_PAGE=true
