{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Sin tipos globales de Node: Buffer, fs, etc. no existen en el teléfono.
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
