# URL del backend-auth tal como la ve el teléfono / emulador.
#  - Teléfono físico: IP LAN del computador (ej. http://192.168.1.10:4000)
#  - Emulador Android: http://10.0.2.2:4000
#  - Simulador iOS:    http://localhost:4000
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# client_id público registrado en el backend (NO existe client_secret en la app)
EXPO_PUBLIC_OAUTH_CLIENT_ID=unisabana-mobile
